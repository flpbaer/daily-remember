# Token do bot (Discord Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=

# Fuso horário usado para agendar e exibir os horários
TIMEZONE=America/Sao_Paulo

# Precisa do "Server Members Intent" ligado no portal: permite escolher membros
# na CLI e enviar no privado para todos de um cargo
MEMBERS_INTENT=true

# A cada quantos segundos o bot verifica lembretes pendentes
POLL_SECONDS=15

# Se o bot ficou desligado e perdeu um horário, ainda envia se o atraso for menor que isso
GRACE_MINUTES=30
